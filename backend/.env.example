# ─── Database ────────────────────────────────────────────────────────────────
# Get this from https://neon.tech (free tier)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=10080

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
# Get from https://aws.amazon.com/s3 (free 5GB)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_CONSENT=trialgo-consent-docs
S3_BUCKET_REPORTS=trialgo-patient-reports
S3_BUCKET_WEARABLE=trialgo-wearable-data
S3_BUCKET_FHIR=trialgo-fhir-bundles

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
# Get from https://twilio.com (free trial)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
# Get from https://sendgrid.com (free 100 emails/day)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ─── Social / Reddit / Twitter (optional) ────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
TWITTER_BEARER_TOKEN=

# ─── FHIR ─────────────────────────────────────────────────────────────────────
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# ─── AI / LLM Keys ────────────────────────────────────────────────────────────
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=your_openai_key
# Google AI Studio: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key
# Groq (free): https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# ─── HuggingFace (optional, for translation) ─────────────────────────────────
HF_MODEL_NAME=facebook/nllb-200-distilled-600M
HF_TOKEN=your_hf_token

# ─── Redis (set automatically by Railway) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── URLs (set after deploying) ──────────────────────────────────────────────
FRONTEND_URL=https://your-project.vercel.app
